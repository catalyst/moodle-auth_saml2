    @template auth_saml2/idp_edit_form

    IdP edit form displayed inside the edit modal.
}}

<form class="auth_saml2-idp-edit-form">

    <input type="hidden" name="idpid" value="{{idpid}}">

    {{! Source. }}
    <div class="auth_saml2-idp-edit-form__source mb-4">
        <div class="form-label mb-1">
            {{sourceLabel}}
        </div>
    </div>

    {{! Display name. }}
    <div class="mb-4">
        <label class="form-label d-block">
            {{displayNameLabel}}
        </label>

        <input
            type="text"
            class="form-control"
            name="displayname"
            value="{{displayname}}"
            placeholder="{{defaultname}}">
    </div>

    {{! IdP settings. }}
    <fieldset class="auth_saml2-idp-edit-form__settings mb-4">
        <legend class="h6 mb-3">
            {{settingsLabel}}
        </legend>

        <div class="form-check mb-2">
            <label class="form-check-label">
                <input
                    type="checkbox"
                    class="form-check-input"
                    name="defaultidp"
                    {{#defaultIdpChecked}}checked{{/defaultIdpChecked}}>
                {{defaultIdpLabel}}
            </label>
        </div>

        <div class="form-check">
            <label class="form-check-label">
                <input
                    type="checkbox"
                    class="form-check-input"
                    name="adminidp"
                    {{#adminChecked}}checked{{/adminChecked}}>
                {{adminLabel}}
            </label>

            {{#hasAdminHelp}}
                <div class="form-text auth_saml2-idp-edit-form__help">
                    {{adminHelp}}
                </div>
            {{/hasAdminHelp}}
        </div>
    </fieldset>

    {{! Whitelist. }}
    <div class="mb-3">
        <label class="form-label d-block">
            {{whitelistLabel}}
        </label>

        <textarea
            class="form-control"
            name="whitelist"
            rows="3">{{whitelist}}</textarea>

        {{#hasWhitelistHelp}}
            <div class="form-text">
                {{whitelistHelp}}
            </div>
        {{/hasWhitelistHelp}}
    </div>

</form>